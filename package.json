{
  "name": "watchmen",
  "version": "0.5.0",
  "description": "A local-first Windows network traffic monitor",
  "main": "electron/main.cjs",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "agent:build": "node scripts/build-agent.cjs",
    "start": "electron .",
    "package": "npm run build && npm run agent:build && node scripts/package.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:smoke": "node scripts/smoke.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
